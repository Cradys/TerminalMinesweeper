{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "prefer-const": "error",
    "typescript/strict-boolean-expressions": "warn",
    "typescript/no-unnecessary-condition": "warn",
    "typescript/no-unnecessary-type-parameters": "error"
  },
  "env": {
    "builtin": true
  }
}